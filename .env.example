# Copy to .env (never commit it) or set these in your host dashboard. All are optional for local development.

# --- core ---
DEBUG=1                      # 0 in production
SECRET_KEY=                  # required when DEBUG=0; generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=               # comma separated, e.g. mes.example.com (Render's own hostname is added automatically)
CSRF_TRUSTED_ORIGINS=        # comma separated, e.g. https://mes.example.com
TIME_ZONE=Europe/London

# --- database: leave DATABASE_URL empty for local SQLite ---
DATABASE_URL=                # e.g. postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# --- access ---
MES_REQUIRE_LOGIN=0          # 1 in production: everyone must sign in

# --- Open-MES ---
MES_DATA_PACK=generic        # the data pack `manage.py seed` loads
MES_LABOUR_RATE_PER_HOUR=28
